GAME_MODE=demo
GAME_BASE_URL=https://play.stonkscape.com/rs2.cgi
STONKSCAPE_BRIDGE_URL=
STATE_FILE=./data/state.json
POLL_SECONDS=2
MAX_CONCURRENT_USERS=10

